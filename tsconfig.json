{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    // Strict, and then stricter. The engine this reads refuses to state anything its
    // evidence does not support, and a viewer that silently coerced a missing field into
    // a plausible default would undo that at the last step. `noUncheckedIndexedAccess`
    // is the one that matters most here: every document on this site is parsed from JSON
    // and indexed by a name that came out of a file.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "scripts", "vite.config.ts"]
}
